# فقط مقادیر غیرمحرمانه. Secretها از ExternalSecret (Vault) می‌آیند.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
PRESENTATION_DRIVER=fastify

OTEL_SERVICE_NAME=nexus-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4318
LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
TRACING_LEVEL=easy

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# در prod ابزارهای مستندسازی خاموش (نیازمند اصلاح env.ts که در همین تغییرات هست)
SWAGGER_UI_ENABLED=false
REBUILD_DOCS=false
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=https://app.mydomain.com,https://admin.mydomain.com

KAFKA_BROKER=nexus-kafka-kafka-bootstrap:9092
KAFKA_BROKERS=nexus-kafka-kafka-bootstrap:9092
KAFKAJS_NO_PARTITIONER_WARNING=1
KAFKA_CONSUME_TOPIC=nexus.user
KAFKA_REPLY_TOPIC=email.notifications.reply
KAFKA_DLQ_TOPIC=email.notifications.dlq

# آدرس S3 واقعی خودت را اینجا بگذار
S3_ENDPOINT=s3.example.com:443
S3_BUCKET_NAME=nexus-pdfs
S3_USE_SSL=true
S3_REGION=us-east-1
