# فقط مقادیر غیرمحرمانه. Secretها (DB، S3، JWT) از secretGenerator / ExternalSecret می‌آیند.
# آدرس‌ها مخصوص کلستر هستند (نه docker-compose / localhost).
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
PRESENTATION_DRIVER=fastify

# Observability (namespace: monitoring). نام Serviceها را با `kubectl -n monitoring get svc` چک کن.
OTEL_SERVICE_NAME=nexus-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.monitoring.svc.cluster.local:4318
LOKI_URL=http://loki.monitoring.svc.cluster.local:3100
TRACING_LEVEL=mid

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

SWAGGER_UI_ENABLED=true
REBUILD_DOCS=true
# از داخل pod به خودش (Mesh برای فراخوانی OpenAPI استفاده می‌کند)
API_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://dev.example.com

# Kafka (Strimzi bootstrap service)
KAFKA_BROKER=nexus-kafka-kafka-bootstrap:9092
KAFKA_BROKERS=nexus-kafka-kafka-bootstrap:9092
KAFKAJS_NO_PARTITIONER_WARNING=1
KAFKA_CONSUME_TOPIC=nexus.user
KAFKA_REPLY_TOPIC=email.notifications.reply
KAFKA_DLQ_TOPIC=email.notifications.dlq

# Redis و SMTP آزمایشی (email-deps-dev.yaml)
REDIS_URL=redis://redis-service:6379
SMTP_HOST=mailpit
SMTP_PORT=1025

# S3 / MinIO (کلیدها در Secret با نام nexus-s3)
S3_ENDPOINT=minio-service:9000
S3_BUCKET_NAME=nexus-pdfs
S3_USE_SSL=false
S3_REGION=us-east-1
