{
  "name": "@nexus/email-worker",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run --dir test  --passWithNoTests",
    "lint": "eslint .",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker build -t nexus-email-worker:latest -f Dockerfile ../.."
  },
  "dependencies": {
    "@nexus/application": "*",
    "@nexus/domain": "*",
    "@nexus/infrastructure": "*",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.1",
    "kafkajs": "^2.2.4",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "@types/kafkajs": "^1.8.2",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
